# =============================================================================
# SubscriptIQ Root Environment Configuration (Template / Example)
# =============================================================================

PROJECT_NAME="SubscriptIQ Text-to-SQL Engine"

# AI Model Names
GROQ_MODEL_PRIMARY="openai/gpt-oss-120b"
GROQ_MODEL_SECONDARY="openai/gpt-oss-20b"
GOOGLE_MODEL_PRIMARY="gemini-3.1-flash-lite"
GOOGLE_MODEL_SECONDARY="gemma-4-26b-a4b-it"

DEFAULT_MODEL="openai/gpt-oss-120b"
ALLOWED_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b,gemini-3.1-flash-lite,gemma-4-26b-a4b-it"

# API Keys (Provide your own API keys for live cloud model evaluation)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GEMINI_API_KEY="AIzaSy_your_gemini_api_key_here"

# PostgreSQL Database
DB_HOST="localhost"
DB_PORT=5433
DB_USER="postgres"
DB_PASSWORD=""
DB_NAME="subscriptiq"
DATABASE_URL="postgresql://postgres:@localhost:5433/subscriptiq"

# Qdrant Vector Store
QDRANT_COLLECTION="sql_few_shot_examples"

# Currency (INR for Indian users)
APP_CURRENCY="INR"
APP_CURRENCY_SYMBOL="₹"

# Frontend Vite Variables
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_DEFAULT_MODEL="openai/gpt-oss-120b"
VITE_GROQ_MODEL_PRIMARY="openai/gpt-oss-120b"
VITE_GROQ_MODEL_SECONDARY="openai/gpt-oss-20b"
VITE_GOOGLE_MODEL_PRIMARY="gemini-3.1-flash-lite"
VITE_GOOGLE_MODEL_SECONDARY="gemma-4-26b-a4b-it"
VITE_CURRENCY_CODE="INR"
VITE_CURRENCY_SYMBOL="₹"
